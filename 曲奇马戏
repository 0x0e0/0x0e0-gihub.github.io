<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>萌宠翻牌配对 · 小动物乐园</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(145deg, #f9e7d2 0%, #f5d0c5 100%);
            font-family: system-ui, 'Segoe UI', 'Helvetica Neue', 'Noto Sans', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        /* 游戏主面板 */
        .game-container {
            width: 100%;
            max-width: 550px;
            margin: 0 auto;
            background-color: rgba(255, 248, 235, 0.7);
            backdrop-filter: blur(2px);
            border-radius: 64px 64px 48px 48px;
            box-shadow: 0 20px 35px rgba(0, 0, 0, 0.1), 0 8px 12px rgba(0, 0, 0, 0.05);
            padding: 20px 16px 28px;
            transition: all 0.2s ease;
        }

        /* 头部区域 */
        .game-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 28px;
            padding: 0 8px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .game-title {
            font-size: 1.9rem;
            font-weight: 800;
            background: linear-gradient(135deg, #f6a7c1, #f9c45a);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 2px 2px 8px rgba(255,215,150,0.6);
            letter-spacing: -0.5px;
        }

        .game-title small {
            font-size: 0.8rem;
            font-weight: 400;
            background: none;
            color: #e28b6f;
            -webkit-background-clip: unset;
            background-clip: unset;
            display: inline-block;
            margin-left: 6px;
        }

        .reset-btn {
            background-color: #ffcf9a;
            border: none;
            font-size: 1.2rem;
            font-weight: bold;
            padding: 8px 18px;
            border-radius: 60px;
            color: #aa6f4b;
            box-shadow: 0 5px 0 #c2865b;
            cursor: pointer;
            transition: 0.08s linear;
            display: flex;
            align-items: center;
            gap: 8px;
            backdrop-filter: blur(4px);
            background: rgba(255, 220, 170, 0.95);
        }

        .reset-btn:active {
            transform: translateY(2px);
            box-shadow: 0 2px 0 #c2865b;
        }

        /* 卡片网格 4x4 */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            justify-items: center;
            align-items: center;
            margin-bottom: 20px;
            padding: 4px;
        }

        /* 卡片样式 */
        .card {
            aspect-ratio: 1 / 1;
            width: 100%;
            background-color: #ffe2c9;
            background-image: radial-gradient(circle at 35% 30%, rgba(255,245,215,0.7) 2%, transparent 2.5%);
            background-size: 18px 18px;
            border-radius: 28px;
            box-shadow: 0 12px 18px -6px rgba(0, 0, 0, 0.2), inset 0 -2px 0 rgba(0,0,0,0.05);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.12s ease, box-shadow 0.1s, background 0.2s;
            font-size: 3.2rem;
            font-weight: 500;
            color: #7b4a2e;
            transform: scale(1);
            text-shadow: 2px 2px 6px rgba(0,0,0,0.1);
        }

        .card:active {
            transform: scale(0.96);
            box-shadow: 0 6px 12px -4px rgba(0, 0, 0, 0.2);
        }

        .card.revealed, .card.matched {
            background: #fffaf2;
            background-image: linear-gradient(145deg, #fff6ec, #ffefdf);
            box-shadow: 0 8px 14px -6px rgba(0,0,0,0.15);
            color: #af6b3e;
        }

        .card.matched {
            background: linear-gradient(135deg, #fff0e0, #ffe6d5);
            box-shadow: 0 0 0 2px #fbc490, 0 8px 16px -4px rgba(0,0,0,0.1);
            cursor: default;
            filter: drop-shadow(0 2px 6px rgba(252,176,64,0.3));
        }

        .card.matched:active {
            transform: scale(1);
        }

        /* 状态栏 */
        .game-stats {
            text-align: center;
            margin-top: 12px;
            font-size: 1.2rem;
            font-weight: 600;
            background: #ffedd9;
            display: inline-block;
            width: auto;
            margin-left: auto;
            margin-right: auto;
            padding: 8px 24px;
            border-radius: 80px;
            color: #c47a54;
            backdrop-filter: blur(4px);
            box-shadow: inset 0 1px 4px #ffe0b5, 0 2px 5px rgba(0,0,0,0.05);
        }

        /* 二维码载体区域 */
        .qr-carrier {
            margin-top: 24px;
            padding-top: 16px;
            border-top: 2px dashed rgba(244, 180, 130, 0.5);
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .qr-label {
            font-size: 0.85rem;
            font-weight: 600;
            background: #ffebd2;
            display: inline-block;
            padding: 4px 14px;
            border-radius: 60px;
            color: #c17a52;
            margin-bottom: 12px;
            letter-spacing: 1px;
        }

        .qr-code-box {
            background: white;
            padding: 12px;
            border-radius: 48px;
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.1);
            display: inline-block;
            margin-bottom: 8px;
        }

        .qr-code-box img {
            width: 110px;
            height: 110px;
            display: block;
            border-radius: 28px;
            background: white;
        }

        .qr-tip {
            font-size: 0.75rem;
            color: #b5764c;
            background: rgba(255,238,215,0.8);
            padding: 6px 12px;
            border-radius: 40px;
            max-width: 260px;
            margin-top: 6px;
        }

        .qr-tip span {
            font-weight: bold;
            color: #e6864a;
        }

        /* 弹窗 */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(250, 215, 180, 0.85);
            backdrop-filter: blur(5px);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            visibility: hidden;
            opacity: 0;
            transition: visibility 0.2s, opacity 0.2s;
        }

        .modal-overlay.active {
            visibility: visible;
            opacity: 1;
        }

        .modal-card {
            background-color: #fff8f0;
            max-width: 280px;
            width: 75%;
            border-radius: 56px;
            padding: 30px 20px 36px;
            text-align: center;
            box-shadow: 0 30px 40px rgba(99, 57, 34, 0.3);
            border: 2px solid #ffe2b5;
            animation: bouncePop 0.3s cubic-bezier(0.34, 1.2, 0.64, 1);
        }

        @keyframes bouncePop {
            0% { transform: scale(0.8); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .modal-card h3 {
            font-size: 2rem;
            margin-bottom: 10px;
            color: #e8956a;
        }

        .modal-card p {
            font-size: 1.2rem;
            margin: 16px 0 24px;
            color: #ad6a45;
            font-weight: 500;
        }

        .modal-card button {
            background: #ffcf8a;
            border: none;
            padding: 12px 28px;
            border-radius: 50px;
            font-size: 1.2rem;
            font-weight: bold;
            color: #7a4729;
            box-shadow: 0 5px 0 #c2884b;
            cursor: pointer;
            transition: 0.05s linear;
        }

        .modal-card button:active {
            transform: translateY(2px);
            box-shadow: 0 2px 0 #c2884b;
        }

        footer {
            text-align: center;
            font-size: 0.7rem;
            color: #e5b18b;
            margin-top: 16px;
        }

        @media (max-width: 480px) {
            .cards-grid {
                gap: 10px;
            }
            .card {
                border-radius: 22px;
                font-size: 2.3rem;
            }
            .game-title {
                font-size: 1.5rem;
            }
            .reset-btn {
                padding: 6px 16px;
                font-size: 1rem;
            }
            .game-stats {
                font-size: 1rem;
                padding: 6px 20px;
            }
            .qr-code-box img {
                width: 90px;
                height: 90px;
            }
        }
    </style>
</head>
<body>

<div class="game-container">
    <div class="game-header">
        <div class="game-title">
            🐾 萌宠翻翻乐 <small>小动物配对</small>
        </div>
        <button class="reset-btn" id="resetGameBtn">🔄 新的一局</button>
    </div>

    <div class="cards-grid" id="cardsGrid"></div>

    <div class="game-stats" id="pairStats">
        🧸 配对进度: 0 / 8
    </div>

    <!-- 二维码载体：扫一扫即可同玩 -->
    <div class="qr-carrier" id="qrCarrierArea">
        <div class="qr-label">📱 扫一扫 · 即开即玩</div>
        <div class="qr-code-box" id="qrCodeContainer">
            <img id="dynamicQR" alt="游戏二维码" src="" style="width:110px; height:110px;">
        </div>
        <div class="qr-tip">
            💡 用手机扫码，打开当前页面 → 好友一起挑战！<br>
            <span>✨ 分享给小伙伴 ✨</span>
        </div>
    </div>
    <footer>🐣 点击卡片配对，找到相同的动物伙伴～</footer>
</div>

<!-- 通关弹窗 -->
<div id="winModal" class="modal-overlay">
    <div class="modal-card">
        <h3>🎉 完美通关 🎉</h3>
        <p>所有小动物都找到伙伴啦 🌟</p>
        <button id="modalResetBtn">✨ 再来一局 ✨</button>
    </div>
</div>

<script>
    // ----------------------------- 游戏配置 ---------------------------------
    // 全部换成小动物 emoji (8种可爱动物)
    const PAIR_THEMES = ["🐱", "🐶", "🐰", "🦊", "🐻", "🐼", "🐨", "🐸"];
    const TOTAL_PAIRS = 8;
    const TOTAL_CARDS = TOTAL_PAIRS * 2;

    let cardsArray = [];          // { id, pattern, matched, flipped }
    let firstIndex = null;
    let secondIndex = null;
    let lockBoard = false;
    let matchCount = 0;
    let flipTimeout = null;

    const gridContainer = document.getElementById('cardsGrid');
    const pairStatsSpan = document.getElementById('pairStats');
    const resetBtn = document.getElementById('resetGameBtn');
    const winModal = document.getElementById('winModal');
    const modalResetBtn = document.getElementById('modalResetBtn');

    // ----- 辅助函数 -----
    function updateStatsUI() {
        pairStatsSpan.innerHTML = `🧸 配对进度: ${matchCount} / ${TOTAL_PAIRS}`;
    }

    function shuffleArray(arr) {
        for (let i = arr.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        return arr;
    }

    function initCardData() {
        let rawCards = [];
        for (let i = 0; i < TOTAL_PAIRS; i++) {
            const pattern = PAIR_THEMES[i];
            rawCards.push({ id: Math.random(), pattern, matched: false, flipped: false });
            rawCards.push({ id: Math.random(), pattern, matched: false, flipped: false });
        }
        return shuffleArray(rawCards);
    }

    function updateSingleCardUI(index) {
        const cardDiv = gridContainer.children[index];
        if (!cardDiv) return;
        const cardData = cardsArray[index];
        let displayContent = "?";
        if (cardData.matched) displayContent = cardData.pattern;
        else if (cardData.flipped) displayContent = cardData.pattern;
        else displayContent = "?";
        cardDiv.innerText = displayContent;
        if (cardData.matched) {
            cardDiv.classList.add('matched');
            cardDiv.classList.remove('revealed');
        } else if (cardData.flipped) {
            cardDiv.classList.add('revealed');
            cardDiv.classList.remove('matched');
        } else {
            cardDiv.classList.remove('revealed', 'matched');
        }
    }

    function renderAllCards() {
        for (let i = 0; i < cardsArray.length; i++) {
            updateSingleCardUI(i);
        }
        updateStatsUI();
    }

    function handleMatch(idxA, idxB) {
        cardsArray[idxA].matched = true;
        cardsArray[idxB].matched = true;
        cardsArray[idxA].flipped = false;
        cardsArray[idxB].flipped = false;
        updateSingleCardUI(idxA);
        updateSingleCardUI(idxB);
        matchCount++;
        updateStatsUI();
        firstIndex = null;
        secondIndex = null;
        checkVictory();
    }

    function handleMismatch(idxA, idxB) {
        if (flipTimeout) clearTimeout(flipTimeout);
        flipTimeout = setTimeout(() => {
            if (!cardsArray[idxA].matched && cardsArray[idxA].flipped === true) {
                cardsArray[idxA].flipped = false;
                updateSingleCardUI(idxA);
            }
            if (!cardsArray[idxB].matched && cardsArray[idxB].flipped === true) {
                cardsArray[idxB].flipped = false;
                updateSingleCardUI(idxB);
            }
            firstIndex = null;
            secondIndex = null;
            lockBoard = false;
            flipTimeout = null;
        }, 700);
    }

    function checkVictory() {
        if (matchCount === TOTAL_PAIRS) {
            if (flipTimeout) clearTimeout(flipTimeout);
            lockBoard = false;
            winModal.classList.add('active');
        }
    }

    function onCardClick(clickedIdx) {
        if (lockBoard) return;
        const card = cardsArray[clickedIdx];
        if (!card) return;
        if (card.matched) return;
        if (card.flipped === true) return;

        if (firstIndex === null) {
            cardsArray[clickedIdx].flipped = true;
            updateSingleCardUI(clickedIdx);
            firstIndex = clickedIdx;
            return;
        }

        if (firstIndex !== null && secondIndex === null) {
            if (firstIndex === clickedIdx) return;
            cardsArray[clickedIdx].flipped = true;
            updateSingleCardUI(clickedIdx);
            secondIndex = clickedIdx;

            const card1 = cardsArray[firstIndex];
            const card2 = cardsArray[secondIndex];
            const isMatch = (card1.pattern === card2.pattern);

            if (isMatch) {
                handleMatch(firstIndex, secondIndex);
                if (flipTimeout) clearTimeout(flipTimeout);
                lockBoard = false;
            } else {
                lockBoard = true;
                handleMismatch(firstIndex, secondIndex);
            }
            return;
        }

        // 防御性重置
        if (firstIndex !== null && secondIndex !== null) {
            if (flipTimeout) clearTimeout(flipTimeout);
            for (let i = 0; i < cardsArray.length; i++) {
                if (!cardsArray[i].matched && cardsArray[i].flipped) {
                    cardsArray[i].flipped = false;
                    updateSingleCardUI(i);
                }
            }
            firstIndex = null;
            secondIndex = null;
            lockBoard = false;
            onCardClick(clickedIdx);
        }
    }

    function buildGameBoard() {
        while (gridContainer.firstChild) gridContainer.removeChild(gridContainer.firstChild);
        for (let i = 0; i < cardsArray.length; i++) {
            const cardDiv = document.createElement('div');
            cardDiv.className = 'card';
            cardDiv.innerText = "?";
            cardDiv.setAttribute('data-index', i);
            cardDiv.addEventListener('click', (function(idx) {
                return function() { onCardClick(idx); };
            })(i));
            gridContainer.appendChild(cardDiv);
        }
        renderAllCards();
    }

    function resetAndNewGame() {
        if (flipTimeout) clearTimeout(flipTimeout);
        firstIndex = null;
        secondIndex = null;
        lockBoard = false;
        matchCount = 0;
        cardsArray = initCardData();
        buildGameBoard();
        winModal.classList.remove('active');
        updateStatsUI();
    }

    // ---------- 二维码载体：生成可扫描的二维码 (完全无插件) ----------
    function refreshQRCode() {
        const qrImg = document.getElementById('dynamicQR');
        if (!qrImg) return;
        let currentUrl = window.location.href;
        const isFileProtocol = currentUrl.startsWith('file://');
        const qrApiUrl = `https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(currentUrl)}`;
        qrImg.src = qrApiUrl;
        qrImg.alt = "游戏二维码";
        const tipDiv = document.querySelector('.qr-tip');
        if (tipDiv) {
            if (isFileProtocol) {
                tipDiv.innerHTML = `📌 当前为本地文件，二维码暂不可扫描。<br> 🚀 将本页面部署至<strong>任意Web服务器</strong>，扫码即可在好友手机上开玩！<br> 📱 扫一扫 · 完美载体`;
            } else {
                tipDiv.innerHTML = `📱 扫码即玩当前游戏 · 分享给小伙伴一起配对！<br> ✨ 扫一扫二维码，打开本游戏 ✨`;
            }
        }
    }

    window.addEventListener('load', () => {
        refreshQRCode();
    });

    // 重置按钮 & 模态重置
    resetBtn.addEventListener('click', () => {
        if (flipTimeout) clearTimeout(flipTimeout);
        resetAndNewGame();
    });
    modalResetBtn.addEventListener('click', () => {
        resetAndNewGame();
        winModal.classList.remove('active');
    });
    winModal.addEventListener('click', (e) => {
        if (e.target === winModal) {
            winModal.classList.remove('active');
        }
    });

    // 初始化游戏
    (function initGame() {
        cardsArray = initCardData();
        buildGameBoard();
        matchCount = 0;
        updateStatsUI();
        firstIndex = null;
        secondIndex = null;
        lockBoard = false;
        if (flipTimeout) clearTimeout(flipTimeout);
        winModal.classList.remove('active');
        refreshQRCode();
    })();
</script>
</body>
</html>
